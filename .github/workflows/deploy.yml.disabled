name: Deploy to ECS

on:
  push:
    branches:
      - main
  workflow_dispatch:  # Manual trigger option

env:
  AWS_REGION: ap-northeast-2
  ECR_REPOSITORY: resee-backend
  ECS_CLUSTER: resee-cluster
  ECS_SERVICE_BACKEND: resee-backend-service
  ECS_SERVICE_CELERY_WORKER: resee-celery-worker-service
  ECS_SERVICE_CELERY_BEAT: resee-celery-beat-service
  TASK_DEFINITION_BACKEND: resee-backend-task
  TASK_DEFINITION_CELERY_WORKER: resee-celery-worker-task
  TASK_DEFINITION_CELERY_BEAT: resee-celery-beat-task

jobs:
  deploy:
    name: Deploy to Production (ECS)
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build, tag, and push Docker image to ECR
        id: build-image
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          cd backend

          # Build Docker image
          echo "🔨 Building Docker image..."
          docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG .
          docker tag $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG $ECR_REGISTRY/$ECR_REPOSITORY:latest

          # Push to ECR
          echo "📤 Pushing image to ECR..."
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:latest

          echo "image=$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" >> $GITHUB_OUTPUT
          echo "✅ Image pushed: $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

      - name: Update Backend Task Definition
        id: backend-task-def
        run: |
          # Get current task definition
          TASK_DEF=$(aws ecs describe-task-definition \
            --task-definition ${{ env.TASK_DEFINITION_BACKEND }} \
            --region ${{ env.AWS_REGION }})

          # Update image in task definition
          NEW_TASK_DEF=$(echo $TASK_DEF | jq --arg IMAGE "${{ steps.build-image.outputs.image }}" \
            '.taskDefinition | .containerDefinitions[0].image = $IMAGE |
            del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy)')

          # Register new task definition
          NEW_REVISION=$(aws ecs register-task-definition \
            --region ${{ env.AWS_REGION }} \
            --cli-input-json "$NEW_TASK_DEF" | jq -r '.taskDefinition.revision')

          echo "revision=$NEW_REVISION" >> $GITHUB_OUTPUT
          echo "✅ Backend task definition updated to revision $NEW_REVISION"

      - name: Update Celery Worker Task Definition
        id: worker-task-def
        run: |
          # Get current task definition
          TASK_DEF=$(aws ecs describe-task-definition \
            --task-definition ${{ env.TASK_DEFINITION_CELERY_WORKER }} \
            --region ${{ env.AWS_REGION }})

          # Update image in task definition
          NEW_TASK_DEF=$(echo $TASK_DEF | jq --arg IMAGE "${{ steps.build-image.outputs.image }}" \
            '.taskDefinition | .containerDefinitions[0].image = $IMAGE |
            del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy)')

          # Register new task definition
          NEW_REVISION=$(aws ecs register-task-definition \
            --region ${{ env.AWS_REGION }} \
            --cli-input-json "$NEW_TASK_DEF" | jq -r '.taskDefinition.revision')

          echo "revision=$NEW_REVISION" >> $GITHUB_OUTPUT
          echo "✅ Celery Worker task definition updated to revision $NEW_REVISION"

      - name: Update Celery Beat Task Definition
        id: beat-task-def
        run: |
          # Get current task definition
          TASK_DEF=$(aws ecs describe-task-definition \
            --task-definition ${{ env.TASK_DEFINITION_CELERY_BEAT }} \
            --region ${{ env.AWS_REGION }})

          # Update image in task definition
          NEW_TASK_DEF=$(echo $TASK_DEF | jq --arg IMAGE "${{ steps.build-image.outputs.image }}" \
            '.taskDefinition | .containerDefinitions[0].image = $IMAGE |
            del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy)')

          # Register new task definition
          NEW_REVISION=$(aws ecs register-task-definition \
            --region ${{ env.AWS_REGION }} \
            --cli-input-json "$NEW_TASK_DEF" | jq -r '.taskDefinition.revision')

          echo "revision=$NEW_REVISION" >> $GITHUB_OUTPUT
          echo "✅ Celery Beat task definition updated to revision $NEW_REVISION"

      - name: Deploy Backend Service (with Auto Rollback)
        run: |
          echo "🚀 Deploying Backend service with Circuit Breaker..."
          aws ecs update-service \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service ${{ env.ECS_SERVICE_BACKEND }} \
            --task-definition ${{ env.TASK_DEFINITION_BACKEND }}:${{ steps.backend-task-def.outputs.revision }} \
            --deployment-configuration "\
              minimumHealthyPercent=50,\
              maximumPercent=200,\
              deploymentCircuitBreaker={enable=true,rollback=true}" \
            --force-new-deployment \
            --region ${{ env.AWS_REGION }}

          echo "✅ Backend service deployment initiated with auto-rollback enabled"
          echo "📊 Deployment Config: min=50%, max=200%, circuit-breaker=enabled"

      - name: Deploy Celery Worker Service (with Auto Rollback)
        run: |
          echo "🚀 Deploying Celery Worker service with Circuit Breaker..."
          aws ecs update-service \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service ${{ env.ECS_SERVICE_CELERY_WORKER }} \
            --task-definition ${{ env.TASK_DEFINITION_CELERY_WORKER }}:${{ steps.worker-task-def.outputs.revision }} \
            --deployment-configuration "\
              minimumHealthyPercent=50,\
              maximumPercent=200,\
              deploymentCircuitBreaker={enable=true,rollback=true}" \
            --force-new-deployment \
            --region ${{ env.AWS_REGION }}

          echo "✅ Celery Worker service deployment initiated with auto-rollback enabled"
          echo "📊 Deployment Config: min=50%, max=200%, circuit-breaker=enabled"

      - name: Deploy Celery Beat Service (with Auto Rollback)
        run: |
          echo "🚀 Deploying Celery Beat service with Circuit Breaker..."
          aws ecs update-service \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service ${{ env.ECS_SERVICE_CELERY_BEAT }} \
            --task-definition ${{ env.TASK_DEFINITION_CELERY_BEAT }}:${{ steps.beat-task-def.outputs.revision }} \
            --deployment-configuration "\
              minimumHealthyPercent=0,\
              maximumPercent=100,\
              deploymentCircuitBreaker={enable=true,rollback=true}" \
            --force-new-deployment \
            --region ${{ env.AWS_REGION }}

          echo "✅ Celery Beat service deployment initiated with auto-rollback enabled"
          echo "📊 Deployment Config: min=0%, max=100%, circuit-breaker=enabled (single instance)"

      - name: Wait for Backend service to stabilize
        run: |
          echo "⏳ Waiting for Backend service to reach steady state..."
          aws ecs wait services-stable \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ env.ECS_SERVICE_BACKEND }} \
            --region ${{ env.AWS_REGION }}

          echo "✅ Backend service is stable"

      - name: Wait for Celery services to stabilize
        run: |
          echo "⏳ Waiting for Celery Worker service to reach steady state..."
          aws ecs wait services-stable \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ env.ECS_SERVICE_CELERY_WORKER }} \
            --region ${{ env.AWS_REGION }}

          echo "⏳ Waiting for Celery Beat service to reach steady state..."
          aws ecs wait services-stable \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ env.ECS_SERVICE_CELERY_BEAT }} \
            --region ${{ env.AWS_REGION }}

          echo "✅ All Celery services are stable"

      - name: Verify deployment and rollback status
        run: |
          echo "🔍 Verifying deployment and checking for rollbacks..."

          # Check Backend service status
          BACKEND_INFO=$(aws ecs describe-services \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ env.ECS_SERVICE_BACKEND }} \
            --region ${{ env.AWS_REGION }})

          BACKEND_STATUS=$(echo $BACKEND_INFO | jq -r '.services[0].deployments[0].rolloutState')
          ROLLBACK_TRIGGERED=$(echo $BACKEND_INFO | jq -r '.services[0].deployments[0].failedTasks // 0')

          echo "📊 Backend deployment status: $BACKEND_STATUS"
          echo "🔄 Failed tasks (rollback indicator): $ROLLBACK_TRIGGERED"

          # Check for circuit breaker events
          CIRCUIT_BREAKER_STATUS=$(aws ecs describe-services \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ env.ECS_SERVICE_BACKEND }} \
            --region ${{ env.AWS_REGION }} \
            --query 'services[0].deploymentConfiguration.deploymentCircuitBreaker' \
            --output json)

          echo "⚡ Circuit Breaker Config: $CIRCUIT_BREAKER_STATUS"

          # Test health endpoint (3 retries)
          echo "🏥 Testing health endpoint..."
          for i in {1..3}; do
            HEALTH_CHECK=$(curl -s -o /dev/null -w "%{http_code}" https://reseeall.com/api/health/ || echo "Failed")
            echo "  Attempt $i/3: $HEALTH_CHECK"

            if [ "$HEALTH_CHECK" = "200" ]; then
              echo "✅ Health check passed"
              break
            else
              if [ $i -eq 3 ]; then
                echo "❌ Health check failed after 3 attempts: $HEALTH_CHECK"
                echo "⚠️ Service may have been auto-rolled back by Circuit Breaker"
                exit 1
              fi
              sleep 10
            fi
          done

          # Verify no rollback occurred
          if [ "$BACKEND_STATUS" = "COMPLETED" ]; then
            echo "✅ Deployment completed successfully without rollback"
          elif [ "$BACKEND_STATUS" = "IN_PROGRESS" ]; then
            echo "⏳ Deployment still in progress..."
          else
            echo "⚠️ Deployment status: $BACKEND_STATUS"
            echo "🔄 Check ECS events for rollback details"
          fi

      - name: Deployment summary
        if: always()
        run: |
          echo "# 🚀 Deployment Summary"
          echo ""
          echo "## 📦 Docker Image"
          echo "- **Image**: ${{ steps.build-image.outputs.image }}"
          echo "- **Tag**: ${{ github.sha }}"
          echo ""
          echo "## 🔄 Task Definitions"
          echo "- **Backend**: ${{ env.TASK_DEFINITION_BACKEND }}:${{ steps.backend-task-def.outputs.revision }}"
          echo "- **Celery Worker**: ${{ env.TASK_DEFINITION_CELERY_WORKER }}:${{ steps.worker-task-def.outputs.revision }}"
          echo "- **Celery Beat**: ${{ env.TASK_DEFINITION_CELERY_BEAT }}:${{ steps.beat-task-def.outputs.revision }}"
          echo ""
          echo "## 🌐 Endpoints"
          echo "- **Production**: https://reseeall.com"
          echo "- **API**: https://reseeall.com/api/"
          echo "- **Health**: https://reseeall.com/api/health/"

      - name: Notify success
        if: success()
        run: |
          echo "✅ Deployment to ECS completed successfully!"
          echo "🎉 All services are running and healthy"

      - name: Notify failure
        if: failure()
        run: |
          echo "❌ Deployment failed!"
          echo "Please check the logs above for details."
          echo "💡 Check ECS service events and CloudWatch logs for more information"
          exit 1
